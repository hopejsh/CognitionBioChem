.DS_Store
node_modules/
*.log
.vscode/
.idea/

# Python
.venv/
# The 3.12 environment holds Boltz-2 and its downloaded weights (1.6 GB). Never committed.
.venv312/
__pycache__/
*.py[cod]

# CBC-Memory: the ledger under memory/ledger/ is the source of truth and IS tracked.
# memory/index/ is a pure function of it and is rebuilt in milliseconds, so it is not.
memory/index/
memory/**/*.sqlite3
memory/**/*.npz

# Large raw workflow transcripts; the distilled findings in reviews/ are tracked.
reviews/*_raw_full.json
.venvdockq/

# Editor/agent scaffolding, not part of the project. .claude/launch.json only records how to
# start `python3 -m http.server` for local preview, which the README states directly.
.claude/

# The built long-form documents are deliberately NOT tracked. They are personal reading
# copies, and every one of them is a pure function of data/ plus docs/figures/ -- so the
# generators and the figures are tracked and the outputs are not:
#
#   ./.venv/bin/python platform/build_figures.py \
#     && ./.venv/bin/python platform/build_report.py \
#     && ./.venv/bin/python platform/build_report_ko.py \
#     && ./.venv/bin/python platform/build_deck.py \
#     && ./.venv/bin/python platform/build_pptx.py
#
# They were tracked once, at 2e1831f; that commit is still in the history.
#
# Named by extension rather than one line per file. Word and PowerPoint do not only write the
# file you opened: closing a document can leave "<name> copy.pptx" beside it, and a recovered
# document comes back as "<name> 2.docx". An exact-name list does not cover those, and one of
# them did appear here -- untracked, and one `git add -A` away from being committed. Every
# document at the top of docs/ is generated by platform/build_*.py, so the pattern is the
# honest statement of the rule. Tracked files here live in docs/figures/ and are .png, .json
# or .md, none of which these patterns touch.
docs/*.docx
docs/*.pptx
docs/*.pdf
docs/*.html

# Word's own lock files, created while a document is open.
~$*
docs/~$*

# The manuscript prose. paper/ held the full text of a paper in two languages -- title,
# abstract, introduction, methods, results, discussion, conclusions, plus the deck copy -- and
# publishing the writing is the same disclosure as publishing the .docx, which line 47 already
# refuses. The repository publishes the study: the plans, the artefacts, the folds, the code and
# the guards. What the author writes about it is the author's to place.
# platform/check_paper.py skips rather than fails when this directory is absent.
paper/
